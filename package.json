{
  "name": "digital-ads-portal",
  "version": "1.0.0",
  "description": "Yondr ad library at ads.overyondrdev.com (Cloudflare Worker yondr-ad-portal + R2 + D1)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "wrangler -c wrangler.toml dev",
    "migrate:local": "wrangler -c wrangler.toml d1 migrations apply yondr-ad-portal-db --local",
    "migrate:remote": "wrangler -c wrangler.toml d1 migrations apply yondr-ad-portal-db --remote",
    "seed:local": "node scripts/seed.mjs --local",
    "seed:remote": "node scripts/seed.mjs --remote",
    "render": "node generator/render.mjs",
    "deploy": "wrangler -c wrangler.toml deploy",
    "pull-copy": "node scripts/pull-copy.mjs --remote",
    "typecheck": "tsc -p tsconfig.json",
    "check": "node scripts/check.mjs",
    "fields": "node generator/fields.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Overyondrdev/digital-ads-portal.git"
  }
}
